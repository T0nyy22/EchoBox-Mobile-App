<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with X button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvDetailsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Capsule Details"
                android:textColor="#24213A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="X"
                android:textColor="#24213A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close details" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivCapsuleImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:contentDescription="Capsule image"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvCapsuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Future Message"
            android:textColor="#24213A"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category: Personal"
            android:textColor="#6750A4"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvTargetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target date:"
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Locked"
            android:textColor="#B3261E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDAE5"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Message"
            android:textColor="#24213A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your secret message will appear here."
            android:textColor="#444444"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
